@page "/health"
@inject ApiClient Api

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
        <h1 style="margin-bottom: 0.5rem;">System Health</h1>
        <p style="color: var(--color-text-muted);">Real-time operational status of the RepoPulse API and upstream services.</p>
    </div>
    <button class="btn btn-primary" @onclick="LoadHealthData" disabled="@_isLoading">
        @if (_isLoading)
        {
            <span>Refreshing...</span>
        }
        else
        {
            <span>Refresh Status</span>
        }
    </button>
</div>

@if (_isLoading && _status == null)
{
    <p style="color: var(--color-text-muted);">Fetching diagnostic data...</p>
}
else if (_status != null)
{
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem;">

        <CheckCard Title="API Connectivity"
                   Message="The connection between the Blazor Client and the RepoPulse Backend API."
                   IsHealthy="true" />

        <CheckCard Title="GitHub Upstream API"
                   Message="@_status.Detail"
                   IsHealthy="@_status.IsReachable" />

        <CheckCard Title="GitHub Rate Limit"
                   Message="@($"Remaining: {_status.RateLimitRemaining} / {_status.RateLimitTotal}")"
                   IsHealthy="@(_status.RateLimitRemaining > 0)" />

    </div>

    <div style="margin-top: 2rem; padding: 1.5rem; background-color: #f0f9ff; border-left: 4px solid #3b82f6; border-radius: var(--border-radius);">
        <h4 style="color: #1e3a8a; font-size: 1rem; margin-bottom: 0.5rem; display: flex; align-items: center;">
            <span style="margin-right: 0.5rem; font-size: 1.2rem;">ℹ️</span> About GitHub Rate Limits
        </h4>
        <p style="color: #1e40af; font-size: 0.9rem; margin: 0; line-height: 1.6;">
            RepoPulse intelligently optimises GitHub API usage. Scanning a repository's root directory consumes <strong>1 request</strong>. Downloading each supported manifest file (e.g., package.json) consumes <strong>1 additional request</strong>. Therefore, a single "Fetch" will typically consume between 1 and 4 requests from your unauthenticated hourly limit depending on the repository's complexity.
        </p>
    </div>
}

@code {
    private GitHubHealthStatus? _status;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthData();
    }

    private async Task LoadHealthData()
    {
        _isLoading = true;
        _status = await Api.GetHealthAsync();
        _isLoading = false;
    }
}