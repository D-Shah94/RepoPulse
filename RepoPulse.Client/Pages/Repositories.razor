@page "/repositories"
@inject ApiClient Api
@inject NavigationManager NavManager
@inject IJSRuntime JS


<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <div>
        <h1 style="margin-bottom: 0.5rem;">Tracked Repositories</h1>
        <p style="color: var(--color-text-muted);">Manage your registered GitHub repositories.</p>
    </div>
</div>

<div class="app-grid" style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; align-items: start;">

    <div class="card">
        <h3>Add Repository</h3>
        <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">
            Enter the exact owner and repository name as they appear on GitHub.
        </p>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div style="background-color: #fee2e2; border: 1px solid #f87171; color: #991b1b; padding: 1rem; border-radius: var(--border-radius); margin-bottom: 1.5rem; font-size: 0.9rem;">
                @_errorMessage
            </div>
        }

        <EditForm Model="_newRepo" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            git status

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 500; margin-bottom: 0.5rem;">Owner (e.g., microsoft)</label>
                <InputText @bind-Value="_newRepo.Owner" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border-color); border-radius: var(--border-radius);" />
                <ValidationMessage For="@(() => _newRepo.Owner)" style="color: var(--color-danger); font-size: 0.85rem; margin-top: 0.25rem;" />
            </div>

            <div style="margin-bottom: 1rem;">
                <label style="display: block; font-weight: 500; margin-bottom: 0.5rem;">Repository Name (e.g., vscode)</label>
                <InputText @bind-Value="_newRepo.RepoName" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border-color); border-radius: var(--border-radius);" />
                <ValidationMessage For="@(() => _newRepo.RepoName)" style="color: var(--color-danger); font-size: 0.85rem; margin-top: 0.25rem;" />
            </div>

            <div style="margin-bottom: 1.5rem;">
                <label style="display: block; font-weight: 500; margin-bottom: 0.5rem;">Description (Optional)</label>
                <InputText @bind-Value="_newRepo.Description" class="form-control" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border-color); border-radius: var(--border-radius);" />
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%;" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span>Registering...</span>
                }
                else
                {
                    <span>Register Repository</span>
                }
            </button>
        </EditForm>
    </div>

    <div class="card table-container">
        @if (_isLoading)
        {
            <p style="padding: 1rem; color: var(--color-text-muted);">Loading repositories...</p>
        }
        else if (_repositories == null || !_repositories.Any())
        {
            <div style="padding: 3rem 1rem; text-align: center;">
                <span style="font-size: 2rem;">📦</span>
                <h3 style="margin-top: 1rem;">No repositories tracked</h3>
                <p style="color: var(--color-text-muted);">Use the form to register your first GitHub repository.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Repository</th>
                        <th>Last Fetched</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var repo in _repositories)
                    {
                        <tr>
                            <td>
                                <div style="font-weight: 600;">@repo.FullName</div>
                                @if (!string.IsNullOrEmpty(repo.Description))
                                {
                                    <div style="font-size: 0.85rem; color: var(--color-text-muted);">@repo.Description</div>
                                }
                            </td>
                            <td>
                                @if (repo.LastFetchedAt.HasValue)
                                {
                                    <span style="font-size: 0.9rem;">@repo.LastFetchedAt.Value.ToLocalTime().ToString("g")</span>
                                }
                                else
                                {
                                    <span class="badge" style="background-color: #f1f5f9; color: #64748b;">Never</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <button class="btn btn-primary" style="padding: 0.25rem 0.75rem; font-size: 0.85rem; margin-right: 0.5rem;" @onclick="() => ViewDetails(repo.Id)">
                                    View
                                </button>
                                <button class="btn btn-danger" style="padding: 0.25rem 0.75rem; font-size: 0.85rem;" @onclick="() => DeleteRepository(repo.Id)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IReadOnlyList<RepositoryDto>? _repositories;
    private bool _isLoading = true;
    private bool _isSubmitting = false;

    // Initialize our DTO for the form
    // Initialize our DTO for the form
    private CreateRepositoryDto _newRepo = new CreateRepositoryDto();

    protected override async Task OnInitializedAsync()
    {
        await LoadRepositoriesAsync();
    }

    private async Task LoadRepositoriesAsync()
    {
        _isLoading = true;
        _repositories = await Api.GetRepositoriesAsync();
        _isLoading = false;
    }

     private async Task HandleValidSubmit()
    {
        _isSubmitting = true;
        _errorMessage = null; // Clear previous errors

        var created = await Api.CreateRepositoryAsync(_newRepo);

        if (created != null)
        {
            _newRepo = new CreateRepositoryDto();
            await LoadRepositoriesAsync();
        }
        else
        {
            // Show the error on the screen
            _errorMessage = "Failed to register repository. Please verify the Owner and Name are correct and that GitHub is reachable.";
        }

        _isSubmitting = false;
    }

    private async Task DeleteRepository(int id)
    {
        // This triggers a native browser pop-up box!
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this repository? This will wipe all historical data.");

        if (confirmed)
        {
            await Api.DeleteRepositoryAsync(id);
            await LoadRepositoriesAsync();
        }
    }

    private void ViewDetails(int id)
    {
        NavManager.NavigateTo($"/repositories/{id}");
    }

    private string? _errorMessage;
}